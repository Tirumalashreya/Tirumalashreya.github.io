# Frontend (build-time). "llm" makes the chat widget call /api/ask; anything else = scripted answers only.
VITE_ASK_AGENT_MODE=scripted

# Serverless function (set in Vercel → Project → Settings → Environment Variables, never in frontend code)
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=
